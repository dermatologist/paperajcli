{
  "name": "paperajcli",
  "description": "Convert MS-Word files to latex",
  "version": "0.1.0",
  "author": "Bell Eapen",
  "bin": {
    "paperajcli": "bin/run.js"
  },
  "bugs": "https://github.com/dermatologist/paperajcli/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^25",
    "@types/sinon": "^21.0.0",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^10",
    "oclif": "^4",
    "shx": "^0.3.3",
    "sinon": "^21.0.1",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/repos/paperajcli",
  "keywords": [
    "oclif",
    "paperaj"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "paperajcli",
    "dirname": "paperajcli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dermatologist/paperajcli.git"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "fix": "eslint . --ext .ts --fix",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "echo 'npm run lint'",
    "prepack": "oclif manifest && oclif readme",
    "testall": "mocha --forbid-only \"test/**/*.test.ts\"",
    "test": "mocha --forbid-only \"test/**/!(*.e2e).test.ts\"",
    "docs": "typedoc --exclude src/tool.ts --html docs src",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
